# Healarr — files to keep out of git

# Secrets & runtime config
.env
.env.local
.env.test

# Persistent state (per-deploy) — root-level only; healarr/state/ is source.
/state/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS noise
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# Logs
*.log

# Go build output & local secrets
/dist/
*.db
*.db-wal
*.db-shm
secrets.toml
