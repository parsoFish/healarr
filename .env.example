# =============================================================================
# Healarr — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# This file is the canonical reference; healarr.config.load() reads from here.
# =============================================================================

# -----------------------------------------------------------------------------
# Service endpoints (Healarr reads from these — read-only access in Phase 1+2,
# read-write from Phase 3 onwards subject to tier policy in docs/tools.md).
# -----------------------------------------------------------------------------
HEALARR_RADARR_URL=http://radarr:7878
HEALARR_RADARR_API_KEY=

HEALARR_SONARR_URL=http://sonarr:8989
HEALARR_SONARR_API_KEY=

HEALARR_PROWLARR_URL=http://prowlarr:9696
HEALARR_PROWLARR_API_KEY=

HEALARR_OVERSEERR_URL=http://overseerr:5055
HEALARR_OVERSEERR_API_KEY=

HEALARR_QBITTORRENT_URL=http://qbittorrent:8080
# qBit auth: empty if you've enabled subnet-bypass for the docker network;
# otherwise provide HEALARR_QBITTORRENT_USER + HEALARR_QBITTORRENT_PASS.
HEALARR_QBITTORRENT_USER=
HEALARR_QBITTORRENT_PASS=

HEALARR_PLEX_URL=http://plex:32400
HEALARR_PLEX_TOKEN=

# -----------------------------------------------------------------------------
# Outbound email
# -----------------------------------------------------------------------------
# When true, Healarr shells out to the host's msmtp binary using the mounted
# ~/.msmtprc. Means zero SMTP creds in this file. Recommended on Pi hosts that
# already have msmtp configured (the default for simplarr deployments).
HEALARR_SMTP_VIA_MSMTP=true

# Where Healarr's emails appear to come from / go to.
HEALARR_FROM_EMAIL=healarr@your-domain
HEALARR_TO_EMAIL=you@your-domain

# Path to the host's msmtprc to mount into the container. Read by docker-compose
# only — change there if your host user isn't 'parso'.
HEALARR_HOST_MSMTPRC=/home/parso/.msmtprc

# -----------------------------------------------------------------------------
# Inbound email (IMAP) — used to receive approval replies.
# Use an app-specific password for Gmail / iCloud / Outlook (limits blast
# radius if .env leaks).
# -----------------------------------------------------------------------------
HEALARR_IMAP_HOST=imap.your-provider.com
HEALARR_IMAP_PORT=993
HEALARR_IMAP_USER=you@your-domain
HEALARR_IMAP_PASS=
HEALARR_IMAP_MAILBOX=INBOX
HEALARR_IMAP_POLL_SECS=60

# -----------------------------------------------------------------------------
# Anthropic API
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Model identifier. Default is Sonnet 4.6. Phase 4 introduces routing
# (Haiku 4.5 for routine events, Sonnet for complex correlation).
HEALARR_AGENT_MODEL=claude-sonnet-4-6

# Daily budget guardrails (USD). At soft alert, an email is sent. At hard cap,
# the agent is paused and an escalation email is sent. Counter resets at
# midnight UTC.
HEALARR_BUDGET_SOFT_USD=3.0
HEALARR_BUDGET_HARD_USD=10.0

# -----------------------------------------------------------------------------
# Operational knobs
# -----------------------------------------------------------------------------
# State database path inside the container. Default lives on the mounted
# /var/lib/healarr volume so it survives container recreations.
HEALARR_STATE_DB=/var/lib/healarr/state.db

# Polling cadence for the Monitor loop (seconds).
HEALARR_MONITOR_POLL_SECS=300

# Dry-run: agent runs but neither Nudge nor Correct tools execute. Useful
# when first onboarding to see what it would do without it actually doing.
HEALARR_DRY_RUN=false

# Host directory holding the SQLite DB + logs. Mounted to /var/lib/healarr.
HEALARR_STATE_DIR=./state
